# ============================================================
# dealsense - environment variables template
# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file to GitHub.
# ============================================================

# --- Speech-to-text + LLM reasoning (both via Groq - one key for both) ---
GROQ_API_KEY=your_groq_api_key_here
WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=openai/gpt-oss-120b

# --- Speaker labelling (pyannote.audio, via Hugging Face) ---
HF_TOKEN=your_huggingface_token_here

# --- Audio handling ---
MAX_CHUNK_MB=20
TARGET_SAMPLE_RATE=16000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dealsense

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
