# ============================================================
# dealsense - environment variables template
# Copy this file to ".env" and fill in your real values.
# Never commit the real .env file to GitHub.
# ============================================================

# --- Speech-to-text (Groq-hosted Whisper, free tier) ---
GROQ_API_KEY=your_groq_api_key_here
WHISPER_MODEL=whisper-large-v3

# --- Speaker labelling (pyannote.audio, via Hugging Face) ---
HF_TOKEN=your_huggingface_token_here

# --- Reasoning layer (LLM that writes the plain-English explanation) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=your_llm_model_name_here

# --- Audio handling ---
MAX_CHUNK_MB=20
TARGET_SAMPLE_RATE=16000

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dealsense

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
